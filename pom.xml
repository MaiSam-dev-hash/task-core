<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.11</version>
		<relativePath/>
	</parent>

	<groupId>sn.isi.l3gl.core</groupId>
	<artifactId>task-core</artifactId>
	<version>0.3.0</version>
	<name>task-core</name>
	<description>Module métier pour gestion de tâches</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<!-- Spring Boot JPA -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Spring Boot Web (pour tests locaux si besoin) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- MYSQL -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Tests -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
		</plugins>
	</build>

	<distributionManagement>
		<!-- Repository Release -->
		<repository>
			<id>nexus-releases</id>
			<name>Task Core Releases</name>
			<url>http://localhost:8081/repository/task-core-releases/</url>
		</repository>

		<!-- Repository Snapshot -->
		<snapshotRepository>
			<id>nexus-snapshots</id>
			<name>Task Core Snapshots</name>
			<url>http://localhost:8081/repository/task-core-snapshots/</url>
		</snapshotRepository>
	</distributionManagement>

</project>